# Copy to /etc/multi-proxmox-manager/mmp.env. Do not commit the real file.
APP_ENV=production
APP_ORIGIN=https://proxmox-manager.example.com
HTTP_ADDR=127.0.0.1:8080

# User: mmp_app, schema: multi_proxmox_manager.
# Keep MySQL local to this VM where possible. parseTime and loc=UTC are required.
MYSQL_DSN="mmp_app:REPLACE_WITH_LONG_RANDOM_PASSWORD@tcp(127.0.0.1:3306)/multi_proxmox_manager?parseTime=true&loc=UTC&time_zone=%27%2B00%3A00%27&charset=utf8mb4&collation=utf8mb4_0900_ai_ci"

# Generate independently; do not reuse the same key.
# JWT_SECRET: openssl rand -hex 48
# CREDENTIALS_ENCRYPTION_KEY: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
CREDENTIALS_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# True in production behind HTTPS. Only use false for local development.
COOKIE_SECURE=true

# IMPORTANT: replace with only your Proxmox management CIDRs.
# Example only; do not blindly allow all RFC1918 networks.
PVE_ALLOWED_CIDRS=172.30.0.0/24

# Optional CA bundle for Proxmox API certificates issued by your internal CA.
# Keep certificate verification enabled; never use insecure TLS verification.
PVE_CA_FILE=/etc/multi-proxmox-manager/pve-ca-bundle.pem
